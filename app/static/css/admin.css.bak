/* ==========================================================
   MEGA LANCHES ERP
   ADMIN.CSS
========================================================== */

/* ==========================================================
   FONTE DA MARCA (LOGO DO CABEÇALHO)
   Usada SOMENTE no título "MEGA LANCHES" do cabeçalho admin.
   Arquivo local em app/static/fonts/ahkio.ttf (sem dependência
   externa/CDN, conforme preferência do projeto).
========================================================== */

@font-face{

    font-family:"Ahkio";
    src:url("../fonts/ahkio.ttf") format("truetype");
    font-weight:normal;
    font-style:normal;
    font-display:swap;

}


/* ==========================================================
   RESET
========================================================== */

:root{

    --primary:#6F1D1B;
    --primary-dark:#5A1615;
    --primary-light:#8A2B28;
    --accent:#C0392B;

    --background:#F4F5F7;
    --surface:#FFFFFF;

    --text:#2E2E2E;
    --text-light:#777;

    --border:#E2E8F0;

    --success:#198754;
    --danger:#DC3545;
    --warning:#FFC107;

    --shadow:0 4px 12px rgba(0,0,0,.08);

}

*{

    margin:0;
    padding:0;
    box-sizing:border-box;

}

html,
body{

    height:100%;

    font-family:
        "Segoe UI",
        Arial,
        Helvetica,
        sans-serif;

    background:var(--background);

    color:var(--text);

}

/* ==========================================================
   LAYOUT
========================================================== */

.admin-wrapper{

    min-height:100vh;

    display:flex;

    flex-direction:column;

}

/* ==========================================================
   HEADER
========================================================== */

.admin-header{

    height:72px;

    background:var(--primary);

    color:#fff;

    display:flex;

    align-items:center;

    justify-content:space-between;

    padding:0 30px;

    box-shadow:0 2px 8px rgba(0,0,0,.15);

    z-index:100;

}

.admin-header h2{

    font-size:28px;

    font-weight:700;

    letter-spacing:.5px;

}

.admin-header small{

    display:block;

    color:#E8CFCF;

    font-size:13px;

}

.admin-header a{

    color:white;

    text-decoration:none;

    font-weight:bold;

}

.admin-header a:hover{

    color:#FFD7D7;

}

/* ==========================================================
   MAIN
========================================================== */

.admin-main{

    flex:1;

    display:flex;

    min-width:0;

}

/* ==========================================================
   SIDEBAR
========================================================== */

.admin-sidebar{

    width:260px;

    flex-shrink:0;

    background:var(--primary);

    color:white;

    display:flex;

    flex-direction:column;

    padding:20px;

    overflow-y:auto;

}

.admin-sidebar ul{

    list-style:none;

}

.admin-sidebar li{

    margin-bottom:6px;

}

.admin-sidebar a{

    display:block;

    color:white;

    text-decoration:none;

    padding:12px 18px;

    border-radius:8px;

    font-size:15px;

    font-weight:600;

    transition:.20s;

}

.admin-sidebar a:hover{

    background:var(--primary-light);

}

.admin-sidebar a.active{

    background:var(--accent);

}

/* ==========================================================
   CONTENT
========================================================== */

.admin-content{

    flex:1;

    min-width:0;

    padding:35px;

    overflow:auto;

}

/* ==========================================================
   TITLES
========================================================== */

h1{

    font-size:30px;

    margin-bottom:20px;

}

h2{

    margin-bottom:18px;

}

/* ==========================================================
   CARDS
========================================================== */

.card{

    background:var(--surface);

    border-radius:12px;

    padding:25px;

    margin-bottom:25px;

    box-shadow:var(--shadow);

    border-left:6px solid var(--primary);

    overflow-x:auto;

}

.card-title{

    font-size:20px;

    margin-bottom:15px;

    font-weight:600;

}

/* ==========================================================
   TABLES
========================================================== */

table{

    width:100%;

    border-collapse:collapse;

    background:white;

    box-shadow:var(--shadow);

}

thead{

    background:var(--primary);

    color:white;

}

th{

    padding:14px;

    text-align:left;

}

td{

    padding:12px;

    border-bottom:1px solid var(--border);

}

tbody tr:hover{

    background:#FAFAFA;

}

.table-actions{

    display:flex;

    flex-wrap:wrap;

    gap:6px;

    align-items:center;

}

.table-actions .btn{

    min-width:85px;

    text-align:center;

    padding:8px 12px;

    font-size:14px;

}

/* ==========================================================
   BUTTONS
========================================================== */

.btn{

    display:inline-block;

    padding:10px 18px;

    border:none;

    border-radius:8px;

    cursor:pointer;

    text-decoration:none;

    font-weight:600;

    transition:.20s;

}

.btn-primary{

    background:var(--primary);

    color:white;

}

.btn-primary:hover{

    background:var(--primary-light);

}

.btn-success{

    background:var(--success);

    color:white;

}

.btn-danger{

    background:var(--danger);

    color:white;

}

.btn-secondary{

    background:#6C757D;

    color:white;

}

/* ==========================================================
   FORMS
========================================================== */

label{

    display:block;

    margin-bottom:6px;

    font-weight:600;

}

input,
select,
textarea{

    width:100%;

    padding:11px 14px;

    margin-bottom:18px;

    border:1px solid var(--border);

    border-radius:8px;

    font-size:15px;

    background:white;

}

input:focus,
select:focus,
textarea:focus{

    outline:none;

    border-color:var(--primary);

    box-shadow:0 0 5px rgba(111,29,27,.20);

}

/* ==========================================================
   FLASH
========================================================== */

.flash{

    padding:15px;

    border-radius:8px;

    margin-bottom:20px;

}

.flash.success{

    background:#D1E7DD;

    color:#0F5132;

}

.flash.error{

    background:#F8D7DA;

    color:#842029;

}

.flash.warning{

    background:#FFF3CD;

    color:#664D03;

}

/* ==========================================================
   RESPONSIVO
========================================================== */

@media (max-width:992px){

    .admin-main{

        flex-direction:column;

    }

    .admin-sidebar{

        width:100%;

    }

    .admin-content{

        padding:20px;

    }

}

/* ==========================================================
   FORMULÁRIOS
========================================================== */

.form-group{
    max-width:700px;
}

.form-check-row{
    display:flex;
    gap:25px;
    margin:20px 0 30px;
}

.form-check{
    display:flex;
    align-items:center;
    gap:8px;
    font-weight:bold;
    cursor:pointer;
}

.form-check input{
    width:auto;
    margin:0;
}

.form-actions{
    display:flex;
    gap:12px;
    margin-top:35px;
}

.form-actions .btn{
    min-width:180px;
}

.form-actions{
    display:flex;
    gap:12px;
}

.form-actions .btn{

    width:180px;
    height:42px;

    display:flex;
    align-items:center;
    justify-content:center;

    font-size:15px;
    font-weight:bold;

    border-radius:6px;

    text-decoration:none;

    padding:0;

}

.form-actions input.btn{

    appearance:none;
    -webkit-appearance:none;

    border:none;

}

.form-actions a.btn{

    border:none;

}


/* ==========================================================
   LOGOUT
========================================================== */

.logout-link{

    background:none;

    border:none;

    color:#ffffff;

    cursor:pointer;

    font-weight:bold;

    font-size:inherit;

    font-family:inherit;

    padding:0;

    margin:0;

}

.logout-link:hover{

    color:#F8D7DA;

    text-decoration:underline;

}
